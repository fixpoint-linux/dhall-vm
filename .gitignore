# emscripten cache created under the project root when EM_CONFIG points CACHE
# at a relative/expanded-home path during a wasm build; regenerate, don't commit.
.cache/

# Elm + MFE site build artifacts (the fixpoint design-component site)
node_modules/
elm-stuff/
dist/
/vendor/@mfe/

# Zig migration build artifacts
# (the Zig CLI binary + twin drivers build to top-level zig-out/; libdhall.so
#  and the dhake merge-gate build are reproducible via zig build-exe/build-lib)
zig-out/
/zig/lib/
/zig/.zig-cache/
/zig/dhake-build/dhake
/zig/dhake-build/*.o

# C build artifacts from the twin-driver / dhake-ABI compile steps
*.o
